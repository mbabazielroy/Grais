# GRAIS Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# LLM Configuration
# =============================================================================
# API key for OpenAI-compatible LLM service (can be dummy if using local)
OPENAI_API_KEY=your-api-key-or-dummy-token

# LLM provider: 'local' for built-in deterministic scorer, or 'openai' for API
LLM_PROVIDER=local

# Custom LLM endpoint (for self-hosted models)
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-model-name

# =============================================================================
# Application Settings
# =============================================================================
# Environment: 'development' or 'production'
ENVIRONMENT=development

# Server host and port
HOST=0.0.0.0
PORT=8000

# Enable hot reload (development only)
RELOAD=false

# =============================================================================
# Logging
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: 'text' for human-readable, 'json' for structured
LOG_FORMAT=text

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins (leave empty for defaults)
# In production, specify exact origins
# CORS_ORIGINS=https://your-frontend.com,https://api.your-domain.com

# =============================================================================
# Rate Limiting
# =============================================================================
# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# Requests per minute per client IP
RATE_LIMIT_RPM=120

# =============================================================================
# Authentication (Enterprise)
# =============================================================================
# Require API key authentication
REQUIRE_AUTH=false

# Master API key for admin operations (generate with: python -c "import secrets; print(f'grais_{secrets.token_urlsafe(32)}')")
# GRAIS_MASTER_API_KEY=grais_your-secure-key-here

# =============================================================================
# Features
# =============================================================================
# Enable time-series forecasting (requires Prophet or uses linear fallback)
USE_TIMESERIES_FORECAST=0

# =============================================================================
# Data Collection (Optional)
# =============================================================================
# GeoNames API username for geocoding (free registration at geonames.org)
# GEONAMES_USERNAME=your_username

# World Bank API doesn't require authentication
